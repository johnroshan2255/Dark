# Copy to deploy/.env (git-ignored) and fill in.
DARK_DOMAIN=eu1.example.com
# 32+ random bytes, the same on every server of a deployment: openssl rand -hex 32
DARK_SECRET=
# The game's origin(s), comma separated
DARK_ALLOWED_ORIGINS=https://play.example.com
DARK_REGION=eu-west
DARK_MAX_MATCHES=8
DARK_DRAIN_SECS=1200
